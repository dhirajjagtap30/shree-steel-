# Copy this file to .env (or .env.local) and adjust. Vite only exposes variables that start with VITE_.
# Restart `npm run dev` after changing anything here.

# Base URL of the Django REST API (no trailing slash). Example: http://127.0.0.1:8000/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# true  = use the built-in browser mock API (src/mocks) - no backend needed, works exactly like the old localStorage version
# false = call the real backend at VITE_API_BASE_URL
VITE_USE_MOCK=true

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000

# Authorization header scheme: "Bearer" (SimpleJWT) or "Token" (DRF TokenAuthentication)
VITE_AUTH_SCHEME=Bearer

# Optional: artificial delay (ms) for the mock API, handy to preview loading states
VITE_MOCK_DELAY_MS=0
